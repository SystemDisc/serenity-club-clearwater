{
  "version": 1,
  "label": "Google listing report",
  "footer": "GOOGLE LISTING",
  "metrics": [
    "profile_views",
    "actions",
    "calls",
    "directions",
    "website_clicks",
    "bookings",
    "phone_share"
  ],
  "checks": [
    [
      "daily",
      1,
      "calls"
    ],
    [
      "daily",
      2,
      "directions"
    ],
    [
      "daily",
      3,
      "website_clicks"
    ],
    [
